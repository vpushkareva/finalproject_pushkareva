[0.328, "o", "\r\n"]
[0.287, "o", "***Валютный кошелёк***\r\n\r\nКоманды:\r\n<command> register --username <str> --password <str> - регистрация\r\n<command> login --username <str> --password <str> - вход\r\n<command> show-portfolio [--base <str>] - портфель и балансы\r\n<command> buy --currency <str> --amount <float> - купить валюту\r\n<command> sell --currency <str> --amount <float> - продать валюту\r\n<command> get-rate --from <str> --to <str> - курс валюты\r\n<command> update-rates [--source <str>] - обновить курсы из API\r\n<command> show-rates [--currency <str>] [--top <int>] [--base <str>] - курсы из кеша\r\n<command> help - справка\r\n"]
[0.000, "o", "<command> exit - выход\r\n"]
